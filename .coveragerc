[run]
omit =
    */agents/*
    */jobs.py
    */demo/*
    */cli/*
    */sample_tools/*
    */tests/*
    */examples/*
    */plan_registry.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
